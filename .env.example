# API Lighthouse Environment Configuration Template
# Section 12.4: variable names and descriptions only, no real secrets.

# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Local Docker Compose default: postgresql://postgres:postgres@localhost:5432/api_lighthouse_dev
# Local native service default: postgresql://apilh:apilh_dev@localhost:5433/api_lighthouse_dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_lighthouse_dev"

# Auth.js / NextAuth configuration (for future auth tickets)
# AUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
